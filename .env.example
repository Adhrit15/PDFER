# Copy this file to .env and fill in the key. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Everything below is optional (defaults shown).
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
# MAX_DOCS=5
# MAX_FILE_MB=25
# MAX_PAGES=400
# OCR_MAX_PAGES=40
# DATABASE_URL=            # leave empty for a local SQLite file; set a Postgres URL when hosting
# DATA_DIR=./data
# COOKIE_SECURE=1          # turn on when served over HTTPS
# TRUST_PROXY=1            # turn on behind a hosting proxy so guest limits use the visitor's IP
# USER_PDFS_PER_DAY=5
# USER_PAGES_PER_DAY=500
# USER_MESSAGES_PER_DAY=100
# GUEST_PDFS_PER_DAY=2
# GUEST_PAGES_PER_DAY=100
# GUEST_MESSAGES_PER_DAY=15
